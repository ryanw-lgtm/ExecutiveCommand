; Engine configuration file.
config_version=5

[application]

config/name="Executive Command"
config/description="Executive leadership and business management simulation."
config/version="0.1.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6", "C#", "GL Compatibility")
boot_splash/bg_color=Color(0.054, 0.086, 0.149, 1)
boot_splash/show_image=false
config/use_custom_user_dir=true
config/custom_user_dir_name="ExecutiveCommand"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/resizable=true
window/stretch/mode="disabled"
window/stretch/aspect="expand"
window/subwindows/embed_subwindows=true

[dotnet]

project/assembly_name="ExecutiveCommand"

[gui]

common/snap_controls_to_pixels=true
theme/default_font_antialiasing=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.054, 0.086, 0.149, 1)
